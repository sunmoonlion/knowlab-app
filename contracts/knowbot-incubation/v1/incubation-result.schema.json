{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/knowlab/knowbot-incubation/v1/incubation-result.schema.json",
  "$defs": {
    "CallerValue": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "caller",
          "title": "Source",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "source",
        "name"
      ],
      "title": "CallerValue",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "spent": {
          "pattern": "^[0-9]{1,9}(\\.[0-9]{1,6})?$",
          "title": "Spent",
          "type": "string"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "spent"
      ],
      "title": "Cost",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "缺口（第 8.4 节）：要作者定的判断，写成一个问题，附提议与选项；进「待办」\n由作者答。",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "proposal": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Proposal",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "id",
        "question",
        "proposal"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Handback": {
      "additionalProperties": false,
      "properties": {
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceEntry"
          },
          "maxItems": 2000,
          "title": "Sources",
          "type": "array"
        },
        "gaps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "maxItems": 200,
          "title": "Gaps",
          "type": "array"
        },
        "suggestions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Suggestion"
          },
          "maxItems": 500,
          "title": "Suggestions",
          "type": "array"
        },
        "self_check": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SelfCheck"
          },
          "maxItems": 500,
          "title": "Self Check",
          "type": "array"
        }
      },
      "title": "Handback",
      "type": "object"
    },
    "LiteralValue": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "literal",
          "title": "Source",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "source",
        "value"
      ],
      "title": "LiteralValue",
      "type": "object"
    },
    "ObjectBatch": {
      "additionalProperties": false,
      "properties": {
        "max_objects": {
          "maximum": 99,
          "minimum": 1,
          "title": "Max Objects",
          "type": "integer"
        },
        "on_missing": {
          "enum": [
            "stop",
            "request_partial"
          ],
          "title": "On Missing",
          "type": "string"
        }
      },
      "required": [
        "max_objects",
        "on_missing"
      ],
      "title": "ObjectBatch",
      "type": "object"
    },
    "ObjectItem": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "object_item",
          "title": "Source",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "source",
        "name"
      ],
      "title": "ObjectItem",
      "type": "object"
    },
    "ObjectRows": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "object_rows",
          "title": "Source",
          "type": "string"
        },
        "step": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Step",
          "type": "string"
        },
        "output": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "source",
        "step",
        "output"
      ],
      "title": "ObjectRows",
      "type": "object"
    },
    "PlanningNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "goal": {
          "maxLength": 60000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "hit",
            "split",
            "gap",
            "clarify"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 1500,
          "title": "Reason",
          "type": "string"
        },
        "operator": {
          "anyOf": [
            {
              "enum": [
                "leaf",
                "sequence",
                "parallel_join",
                "branch",
                "bounded_loop"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "step": {
          "anyOf": [
            {
              "$ref": "#/$defs/SketchStep"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectBatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "backtracks": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Backtracks",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "goal"
      ],
      "title": "PlanningNode",
      "type": "object"
    },
    "PlanningTree": {
      "additionalProperties": false,
      "properties": {
        "catalog_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Digest",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/PlanningNode"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "pins": {
          "maxProperties": 72,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "type": "string"
            }
          },
          "title": "Pins",
          "type": "object"
        }
      },
      "required": [
        "catalog_digest",
        "nodes"
      ],
      "title": "PlanningTree",
      "type": "object"
    },
    "ResourceValue": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "resource",
          "title": "Source",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "source",
        "requirement_id",
        "role"
      ],
      "title": "ResourceValue",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "clarify",
            "gap"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "maxLength": 1500,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/SketchStep"
          },
          "maxItems": 16,
          "title": "Steps",
          "type": "array"
        },
        "routing_required": {
          "title": "Routing Required",
          "type": "boolean"
        },
        "tree": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanningTree"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "object_batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectBatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "reason",
        "steps",
        "routing_required"
      ],
      "title": "Selection",
      "type": "object"
    },
    "SelfCheck": {
      "additionalProperties": false,
      "description": "自查（第 8.2 节第 4 条）：一条起草时的建议对不上出处或碰到了判断，已经改成\n了这个缺口（turned_into_gap 是缺口编号）；那条建议不再在建议里。",
      "properties": {
        "suggestion_id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Suggestion Id",
          "type": "string"
        },
        "turned_into_gap": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Turned Into Gap",
          "type": "string"
        }
      },
      "required": [
        "suggestion_id",
        "turned_into_gap"
      ],
      "title": "SelfCheck",
      "type": "object"
    },
    "SketchStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "task": {
          "maxLength": 1500,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task",
          "type": "string"
        },
        "method": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Method",
          "type": "string"
        },
        "inputs": {
          "maxProperties": 100,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "discriminator": {
                "mapping": {
                  "caller": "#/$defs/CallerValue",
                  "literal": "#/$defs/LiteralValue",
                  "object_item": "#/$defs/ObjectItem",
                  "object_rows": "#/$defs/ObjectRows",
                  "resource": "#/$defs/ResourceValue",
                  "step": "#/$defs/StepValue"
                },
                "propertyName": "source"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CallerValue"
                },
                {
                  "$ref": "#/$defs/StepValue"
                },
                {
                  "$ref": "#/$defs/LiteralValue"
                },
                {
                  "$ref": "#/$defs/ResourceValue"
                },
                {
                  "$ref": "#/$defs/ObjectItem"
                },
                {
                  "$ref": "#/$defs/ObjectRows"
                }
              ]
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "deliver_as": {
          "maxProperties": 100,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            }
          },
          "title": "Deliver As",
          "type": "object"
        },
        "route_input": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Input"
        },
        "cases": {
          "maxProperties": 8,
          "patternProperties": {
            "\\S": {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 1500,
            "minLength": 1
          },
          "title": "Cases",
          "type": "object"
        },
        "reviews": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Reviews",
          "type": "array"
        }
      },
      "required": [
        "id",
        "task",
        "method"
      ],
      "title": "SketchStep",
      "type": "object"
    },
    "SourceEntry": {
      "additionalProperties": false,
      "description": "出处表的一行（第 8.2、9.1 节）：建议里的一格出自哪里。\n\nidea：创意里逐字的一句（quote，knowlab 核它逐字出现在这一版创意里）；\nanswer：某个答过的缺口（ref 是它的 id）；proposal：AI 的提议，作者接受时页面\n照实标「这是 AI 的提议」。",
      "properties": {
        "path": {
          "pattern": "^(name|tagline|planning|scope|scope/(does|does_not|elsewhere)|steps/[A-Za-z][A-Za-z0-9_-]{0,47}(/(title|does|why|uses|rules|ask_before|outputs|checks|on_fail|selection))?|steps/[A-Za-z][A-Za-z0-9_-]{0,47}/rules/[A-Za-z0-9_-]{1,32}|steps/[A-Za-z][A-Za-z0-9_-]{0,47}/ask_before/[A-Za-z0-9_-]{1,32}|steps/[A-Za-z][A-Za-z0-9_-]{0,47}/outputs/[^\\s./\\\\\\\"'（）()、，,；;：:]{1,64}|steps/[A-Za-z][A-Za-z0-9_-]{0,47}/checks/[0-9]{1,2})$",
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "idea",
            "answer",
            "proposal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "SourceEntry",
      "type": "object"
    },
    "StepValue": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "step",
          "title": "Source",
          "type": "string"
        },
        "step": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Step",
          "type": "string"
        },
        "output": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "source",
        "step",
        "output"
      ],
      "title": "StepValue",
      "type": "object"
    },
    "Suggestion": {
      "additionalProperties": false,
      "description": "对工作稿一格的改动（第 8.3 节），作者接受了才进稿。\n\n路径与 value 的形状同工作稿格子（knowlab workdraft.apply）：set 换掉一格或一块，\nadd 加一步、一条规则、一个交回项、一条验收，remove 删掉（不带 value），move 把\n一步或一条挪到第 value 位（从 0 起）。",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "pattern": "^(name|tagline|planning|scope|scope/(does|does_not|elsewhere)|steps/[A-Za-z][A-Za-z0-9_-]{0,47}(/(title|does|why|uses|rules|ask_before|outputs|checks|on_fail|selection))?|steps/[A-Za-z][A-Za-z0-9_-]{0,47}/rules/[A-Za-z0-9_-]{1,32}|steps/[A-Za-z][A-Za-z0-9_-]{0,47}/ask_before/[A-Za-z0-9_-]{1,32}|steps/[A-Za-z][A-Za-z0-9_-]{0,47}/outputs/[^\\s./\\\\\\\"'（）()、，,；;：:]{1,64}|steps/[A-Za-z][A-Za-z0-9_-]{0,47}/checks/[0-9]{1,2})$",
          "title": "Path",
          "type": "string"
        },
        "op": {
          "enum": [
            "set",
            "add",
            "remove",
            "move"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "op",
        "reason"
      ],
      "title": "Suggestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "knowbot-incubation/v1",
      "title": "Contract",
      "type": "string"
    },
    "incubation_id": {
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "title": "Incubation Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "over_budget",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "cost": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cost"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "task_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f-]{36}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "waiting_for": {
      "anyOf": [
        {
          "enum": [
            "computer_offline",
            "folder_not_ready"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Waiting For"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "handback": {
      "anyOf": [
        {
          "$ref": "#/$defs/Handback"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "contract",
    "incubation_id",
    "status"
  ],
  "title": "knowbot-incubation v1 result",
  "type": "object"
}
