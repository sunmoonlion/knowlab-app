{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/knowlab/knowbot-incubation/v1/incubation-request.schema.json",
  "$defs": {
    "Advanced": {
      "additionalProperties": false,
      "description": "工程层（第 7.2 节「高级」）：不填就用程序生成的。",
      "properties": {
        "tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 30,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "reserve": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,4}(\\.[0-9]{1,4})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reserve"
        },
        "input_max_chars": {
          "anyOf": [
            {
              "maximum": 200000,
              "minimum": 500,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Max Chars"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "output_file": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output File"
        },
        "managed_capabilities": {
          "anyOf": [
            {
              "$ref": "#/$defs/MethodCapabilities"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Advanced",
      "type": "object"
    },
    "AnsweredGap": {
      "additionalProperties": false,
      "description": "作者答过的缺口：问题、当时的提议、作者的答复。出处 answer 的 ref 指 id。",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "proposal": {
          "default": "",
          "maxLength": 4000,
          "title": "Proposal",
          "type": "string"
        },
        "answer": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "question",
        "answer"
      ],
      "title": "AnsweredGap",
      "type": "object"
    },
    "AskBeforeCell": {
      "additionalProperties": false,
      "description": "开步前问用户什么：问题，可以给几个选项（选项是给用户看的字）。",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "default": "",
          "maxLength": 1000,
          "title": "Question",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "AskBeforeCell",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "pattern": "^[0-9]{1,6}(\\.[0-9]{1,2})?$",
          "title": "Limit",
          "type": "string"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "limit"
      ],
      "title": "Budget",
      "type": "object"
    },
    "CapabilityBinding": {
      "additionalProperties": false,
      "properties": {
        "required_units": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Required Units",
          "type": "array"
        },
        "evidence_outputs": {
          "items": {
            "$ref": "#/$defs/CapabilityOutput"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence Outputs",
          "type": "array"
        }
      },
      "required": [
        "required_units",
        "evidence_outputs"
      ],
      "title": "CapabilityBinding",
      "type": "object"
    },
    "CapabilityOutput": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$",
          "title": "Method",
          "type": "string"
        },
        "field": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "method",
        "field"
      ],
      "title": "CapabilityOutput",
      "type": "object"
    },
    "CapabilityPlanningCell": {
      "additionalProperties": false,
      "properties": {
        "method_text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Method Text",
          "type": "string"
        },
        "final_units": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Final Units",
          "type": "array"
        },
        "max_steps": {
          "maximum": 100,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_replans": {
          "maximum": 10,
          "minimum": 0,
          "title": "Max Replans",
          "type": "integer"
        },
        "reserve": {
          "pattern": "^[0-9]{1,4}(\\.[0-9]{1,4})?$",
          "title": "Reserve",
          "type": "string"
        },
        "input_max_chars": {
          "maximum": 200000,
          "minimum": 500,
          "title": "Input Max Chars",
          "type": "integer"
        },
        "capability_bindings": {
          "maxProperties": 30,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,47}$": {
              "$ref": "#/$defs/CapabilityBinding"
            }
          },
          "title": "Capability Bindings",
          "type": "object"
        }
      },
      "required": [
        "method_text",
        "final_units",
        "max_steps",
        "max_replans",
        "reserve",
        "input_max_chars",
        "capability_bindings"
      ],
      "title": "CapabilityPlanningCell",
      "type": "object"
    },
    "CellSource": {
      "additionalProperties": false,
      "description": "工作稿一格的出处（第 9.1 节）：作者写的 user_text，接受或答过的\nuser_confirmed；ref 指编辑记录、接受记录或答过的问题。模型凭它认出哪些格子是\n作者的，只能提修改建议。",
      "properties": {
        "kind": {
          "enum": [
            "user_text",
            "user_confirmed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "CellSource",
      "type": "object"
    },
    "CheckCell": {
      "additionalProperties": false,
      "description": "怎样算对：选一个验收模板，再填参数（参数在 compile 时逐个核）。",
      "properties": {
        "template": {
          "enum": [
            "required",
            "non_empty",
            "list_min",
            "list_empty",
            "blank",
            "each_has",
            "all_equal",
            "computed",
            "identity",
            "sourced",
            "quoted",
            "covers",
            "max_chars"
          ],
          "title": "Template",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "template"
      ],
      "title": "CheckCell",
      "type": "object"
    },
    "ConditionalCheckCell": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "enum": [
            "required",
            "non_empty",
            "list_min",
            "list_empty",
            "blank",
            "each_has",
            "all_equal",
            "computed",
            "identity",
            "sourced",
            "quoted",
            "covers",
            "max_chars"
          ],
          "title": "Template",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "when_input_present": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$",
          "title": "When Input Present",
          "type": "string"
        }
      },
      "required": [
        "template",
        "when_input_present"
      ],
      "title": "ConditionalCheckCell",
      "type": "object"
    },
    "DataDescription": {
      "additionalProperties": false,
      "description": "一份数据在 knowbase 里的描述（0049 的几维：主体、类型、期间、格式、语言）。是\n描述，不是内容；作者自己确认过或系统识别的，照 knowbase 给的转过来。",
      "properties": {
        "subject": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "doc_type": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Type"
        },
        "period_start": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Start"
        },
        "period_end": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period End"
        },
        "data_format": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Format"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        }
      },
      "title": "DataDescription",
      "type": "object"
    },
    "DataFormat": {
      "additionalProperties": false,
      "description": "作者挑的一份数据的格式（0029 第 6.4 节、专家孵化方案第 8.2 节）：名字、文件类型、\n描述的几维、有哪几种读法（正文、按页文字、表格……已就绪的），各表的表名、列标签、\n行标签；不含数据区内容。表轴来自 knowbase 的本人读格式接口；\n不支持的文件类型留空。",
      "properties": {
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "media_type": {
          "default": "",
          "maxLength": 128,
          "title": "Media Type",
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/DataDescription",
          "default": {
            "subject": null,
            "doc_type": null,
            "period_start": null,
            "period_end": null,
            "data_format": null,
            "language": null
          }
        },
        "readings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Readings",
          "type": "array"
        },
        "tables": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TableFormat"
          },
          "maxItems": 50,
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "DataFormat",
      "type": "object"
    },
    "LatestTest": {
      "additionalProperties": false,
      "description": "最近一次有结论的测试的报告（专家孵化方案第 8.4 节「带上测试报告让 AI 改」，0029\n第三节第 5 步）：第几次、测的是准专家第几版、通过没有、每条用例每一步的结果。只有\n报告：成稿、各步交回物、测试数据都不给（0029 第 6.4 节，模型不看数据的内容）。",
      "properties": {
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "draft_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Draft Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "cases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LatestTestCase"
          },
          "maxItems": 50,
          "title": "Cases",
          "type": "array"
        }
      },
      "required": [
        "number",
        "draft_version",
        "status"
      ],
      "title": "LatestTest",
      "type": "object"
    },
    "LatestTestCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "title": "Case Id",
          "type": "string"
        },
        "question": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "needs_human",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LatestTestStep"
          },
          "maxItems": 200,
          "title": "Steps",
          "type": "array"
        },
        "expectations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LatestTestExpectation"
          },
          "maxItems": 64,
          "title": "Expectations",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "case_id",
        "question",
        "status"
      ],
      "title": "LatestTestCase",
      "type": "object"
    },
    "LatestTestExpectation": {
      "additionalProperties": false,
      "description": "作者给这条用例定的一条期望核没核上：哪个交回物的哪一项、怎么比。期望值本身\n不给：模型照着期望值改方法，等于把答案写进规则。",
      "properties": {
        "artifact": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact",
          "type": "string"
        },
        "path": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "equals",
            "approx",
            "contains"
          ],
          "title": "Kind",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "artifact",
        "path",
        "kind",
        "passed"
      ],
      "title": "LatestTestExpectation",
      "type": "object"
    },
    "LatestTestStep": {
      "additionalProperties": false,
      "description": "报告里一步的结果：过没过、没过的验收名、一条一句为什么没过（同测试契约）。",
      "properties": {
        "step_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "failed_checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Failed Checks",
          "type": "array"
        },
        "details": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Details",
          "type": "array"
        }
      },
      "required": [
        "step_id",
        "accepted"
      ],
      "title": "LatestTestStep",
      "type": "object"
    },
    "McpRequirement": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Url",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "url",
        "name"
      ],
      "title": "McpRequirement",
      "type": "object"
    },
    "MethodCapabilities": {
      "additionalProperties": false,
      "properties": {
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/McpRequirement"
          },
          "maxItems": 30,
          "title": "Tools",
          "type": "array"
        },
        "skills": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillRequirement"
          },
          "maxItems": 10,
          "title": "Skills",
          "type": "array"
        }
      },
      "title": "MethodCapabilities",
      "type": "object"
    },
    "MethodExecution": {
      "additionalProperties": false,
      "description": "Expert-owned execution policy; not part of an atomic method's meaning.",
      "properties": {
        "ask_before": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AskBeforeCell"
          },
          "maxItems": 10,
          "title": "Ask Before",
          "type": "array"
        },
        "on_fail": {
          "$ref": "#/$defs/OnFail",
          "default": {
            "kind": "rework",
            "back_to": null
          }
        },
        "advanced": {
          "$ref": "#/$defs/Advanced",
          "default": {
            "tools": null,
            "reserve": null,
            "input_max_chars": null,
            "output_schema": null,
            "output_file": null
          }
        }
      },
      "title": "MethodExecution",
      "type": "object"
    },
    "MethodReference": {
      "additionalProperties": false,
      "properties": {
        "method_id": {
          "format": "uuid",
          "title": "Method Id",
          "type": "string"
        },
        "version": {
          "maximum": 999999,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 30,
          "title": "Inputs",
          "type": "object"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/MethodExecution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "method_id",
        "version",
        "digest"
      ],
      "title": "MethodReference",
      "type": "object"
    },
    "MethodSelection": {
      "additionalProperties": false,
      "description": "作者确认的适用条件、必经与重复上限；不是任务模型新造的方法。",
      "properties": {
        "applies_when": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Applies When",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "max_calls": {
          "maximum": 100,
          "minimum": 1,
          "title": "Max Calls",
          "type": "integer"
        }
      },
      "required": [
        "applies_when",
        "required",
        "max_calls"
      ],
      "title": "MethodSelection",
      "type": "object"
    },
    "OnFail": {
      "additionalProperties": false,
      "description": "没过怎么办：默认重做一次，再不过停下来问；可以改成退回前面某一步，或直接问。",
      "properties": {
        "kind": {
          "default": "rework",
          "enum": [
            "rework",
            "back",
            "ask"
          ],
          "title": "Kind",
          "type": "string"
        },
        "back_to": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Back To"
        }
      },
      "title": "OnFail",
      "type": "object"
    },
    "OptionalStepCell": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 80,
          "title": "Title",
          "type": "string"
        },
        "does": {
          "default": "",
          "maxLength": 20000,
          "title": "Does",
          "type": "string"
        },
        "why": {
          "default": "",
          "maxLength": 1000,
          "title": "Why",
          "type": "string"
        },
        "uses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Uses",
          "type": "array"
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuleCell"
          },
          "maxItems": 50,
          "title": "Rules",
          "type": "array"
        },
