{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/knowlab/knowbot-test-run/v1/test-run-result.schema.json",
  "$defs": {
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "title": "Case Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "needs_human",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StepResult"
          },
          "maxItems": 200,
          "title": "Steps",
          "type": "array"
        },
        "expectations": {
          "default": [],
          "items": {
            "type": "boolean"
          },
          "maxItems": 64,
          "title": "Expectations",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "case_id",
        "status"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "spent": {
          "pattern": "^[0-9]{1,9}(\\.[0-9]{1,6})?$",
          "title": "Spent",
          "type": "string"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "spent"
      ],
      "title": "Cost",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "PendingQuestion": {
      "additionalProperties": false,
      "description": "跑到要人决定的地方。tool_approval：能不能做这件事（运营答）；question：Codex\n反问；ask_before：开步前的提问（key 是清单里提问的 id，答案可记回用例）。",
      "properties": {
        "question_id": {
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "title": "Question Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "title": "Case Id",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "kind": {
          "enum": [
            "tool_approval",
            "question",
            "ask_before"
          ],
          "title": "Kind",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Option"
          },
          "maxItems": 20,
          "title": "Options",
          "type": "array"
        },
        "allow_free_text": {
          "default": true,
          "title": "Allow Free Text",
          "type": "boolean"
        },
        "asked_at": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Asked At",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "case_id",
        "kind",
        "text",
        "asked_at"
      ],
      "title": "PendingQuestion",
      "type": "object"
    },
    "StepResult": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "failed_checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Failed Checks",
          "type": "array"
        },
        "details": {
          "default": [],
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Details",
          "type": "array"
        }
      },
      "required": [
        "step_id",
        "accepted"
      ],
      "title": "StepResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "knowbot-test-run/v1",
      "title": "Contract",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "running",
        "waiting",
        "passed",
        "failed",
        "error",
        "timeout",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "cases": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "maxItems": 50,
      "title": "Cases",
      "type": "array"
    },
    "cost": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cost"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "questions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PendingQuestion"
      },
      "maxItems": 50,
      "title": "Questions",
      "type": "array"
    },
    "waited_seconds": {
      "default": 0,
      "minimum": 0,
      "title": "Waited Seconds",
      "type": "integer"
    }
  },
  "required": [
    "contract",
    "run_id",
    "status"
  ],
  "title": "knowbot-test-run v1 result",
  "type": "object"
}
