{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/knowlab/knowbot-test-run/v1/test-run-request.schema.json",
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "pattern": "^[0-9]{1,6}(\\.[0-9]{1,2})?$",
          "title": "Limit",
          "type": "string"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "limit"
      ],
      "title": "Budget",
      "type": "object"
    },
    "CaseData": {
      "additionalProperties": false,
      "description": "一条用例用的数据（清单 v2，SDD 0046 第三节）：knowbase 签的这条用例的测试运行\n授权与钉住的几份。用例带了就不跑第 0 步；回答 `data` 问题时也是这个形状（几份都\n不要时 items 为空、不带授权）。",
      "properties": {
        "grant_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grant Id"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PinnedInput"
          },
          "maxItems": 200,
          "title": "Items",
          "type": "array"
        }
      },
      "title": "CaseData",
      "type": "object"
    },
    "CaseInput": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "answers": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Answers",
          "type": "object"
        }
      },
      "required": [
        "question"
      ],
      "title": "CaseInput",
      "type": "object"
    },
    "Expectation": {
      "additionalProperties": false,
      "description": "用户定的「怎样算对」：在最后的交回物里，某一项应当等于、约等于或包含什么。",
      "properties": {
        "artifact": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact",
          "type": "string"
        },
        "path": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "equals",
            "approx",
            "contains"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "tolerance": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        }
      },
      "required": [
        "artifact",
        "path",
        "kind",
        "value"
      ],
      "title": "Expectation",
      "type": "object"
    },
    "PinnedInput": {
      "additionalProperties": false,
      "description": "测试集里钉住的一份（清单 v2，SDD 0043 第 2.9 节）：资料、内容版本、读法与摘要、\n权利依据。",
      "properties": {
        "material_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "version_no": {
          "minimum": 1,
          "title": "Version No",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "rendition_kind": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendition Kind"
        },
        "rendition_no": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendition No"
        },
        "rendition_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendition Sha256"
        },
        "basis": {
          "enum": [
            "display",
            "reference",
            "public",
            "frozen_binding"
          ],
          "title": "Basis",
          "type": "string"
        },
        "basis_ref": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Basis Ref",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "media_type": {
          "default": "",
          "maxLength": 128,
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "material_id",
        "version_no",
        "sha256",
        "basis",
        "basis_ref",
        "name"
      ],
      "title": "PinnedInput",
      "type": "object"
    },
    "RunCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "title": "Case Id",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/CaseInput"
        },
        "expectations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Expectation"
          },
          "maxItems": 64,
          "title": "Expectations",
          "type": "array"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "case_id",
        "input"
      ],
      "title": "RunCase",
      "type": "object"
    },
    "Runner": {
      "additionalProperties": false,
      "description": "谁跑这次测试（SDD 0046 第三节）：平台的测试账号（缺省），或用户本人——跑在他接入\n的电脑、他选的工作区根目录、他的模型 key，他出钱。v1 冻结后加的可选字段。",
      "properties": {
        "kind": {
          "enum": [
            "platform",
            "user"
          ],
          "title": "Kind",
          "type": "string"
        },
        "environment_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f-]{36}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Id"
        },
        "workspace_root": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Root"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Runner",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "knowbot-test-run/v1",
      "title": "Contract",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "title": "Run Id",
      "type": "string"
    },
    "owner_subject": {
      "pattern": "^[A-Za-z0-9._:@-]{1,512}$",
      "title": "Owner Subject",
      "type": "string"
    },
    "manifest": {
      "additionalProperties": true,
      "title": "Manifest",
      "type": "object"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/RunCase"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "timeout_seconds": {
      "maximum": 86400,
      "minimum": 60,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "max_wait_seconds": {
      "default": 259200,
      "maximum": 604800,
      "minimum": 60,
      "title": "Max Wait Seconds",
      "type": "integer"
    },
    "runner": {
      "anyOf": [
        {
          "$ref": "#/$defs/Runner"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "contract",
    "run_id",
    "owner_subject",
    "manifest",
    "cases",
    "budget",
    "timeout_seconds"
  ],
  "title": "knowbot-test-run v1 request",
  "type": "object"
}
